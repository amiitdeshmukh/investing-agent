# Application
APP_NAME=Investing Agent API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Added when persistence work begins
DATABASE_URL=
CHROMA_HOST=
CHROMA_PORT=8001

# Added when Groww HTTP integration begins. Never expose these to the frontend.
GROWW_API_KEY=
GROWW_API_SECRET=

# Added when authentication and agent work begin
SESSION_SECRET=
APP_PASSWORD_HASH=
LLM_API_KEY=

# Safe defaults
TRADING_MODE=paper
MARKET_TIMEZONE=Asia/Kolkata
PAPER_STARTING_BALANCE=1000000
